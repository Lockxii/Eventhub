{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    <style>
        body {
            min-height: 100vh;
            background: #f4f6f9;
        }

        .register-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .register-card {
            width: 100%;
            max-width: 420px;
            padding: 2rem;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 28px rgba(20, 35, 60, .1);
        }
    </style>
{% endblock %}

{% block body %}
    <main class="register-page">
        <section class="register-card">
            <h1 class="h3 mb-2">Créer un compte</h1>
            <p class="text-muted mb-4">Remplissez les informations pour vous inscrire.</p>

            {{ form_start(form) }}
                {{ form_row(form.username) }}
                {{ form_row(form.email) }}

                {{ form_errors(form.password) }}
                {{ form_row(form.password.first) }}
                {{ form_row(form.password.second) }}

                <button type="submit" class="btn btn-primary btn-block mt-4">Créer mon compte</button>
            {{ form_end(form) }}

            <p class="text-center text-muted mt-4 mb-0">
                Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </section>
    </main>
{% endblock %}
